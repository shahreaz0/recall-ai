{
  "name": "recall-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --if-present build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "db:push": "pnpm --filter @recall-ai/db db:push",
    "db:studio": "pnpm --filter @recall-ai/db db:studio",
    "db:generate": "pnpm --filter @recall-ai/db db:generate",
    "db:migrate": "pnpm --filter @recall-ai/db db:migrate",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "check": "oxlint && oxfmt --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@recall-ai/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@recall-ai/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vercel": "^58.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --no-error-on-unmatched-pattern"
    ],
    "*": [
      "oxfmt --no-error-on-unmatched-pattern --write"
    ]
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4"
    }
  }
}
